{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/editor",
      "destination": "/index.html"
    },
    {
      "source": "/editor/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/debug",
      "destination": "/index.html"
    }
  ]
}
